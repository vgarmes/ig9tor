---
import { Image } from "astro:assets";
import Element from "@/assets/ig9tor-element.webp";
import Tagline from "@/assets/ig9tor-tagline-en.svg";
import { getImage } from "astro:assets";

const backgroundImage = await getImage({ src: Element });
---

<section
  class="relative mx-auto flex h-[calc(100vh-4rem)] w-full max-w-5xl flex-col items-center justify-center bg-white/70 bg-contain bg-center bg-no-repeat px-4 py-12 text-center bg-blend-lighten"
  style={{ backgroundImage: `url("${backgroundImage.src}")` }}
>
  <div class="animate-fade-in-blur space-y-8">
    <div class="flex justify-center">
      <Image
        src={Tagline}
        alt="it starts with a spark"
        width="932.9"
        height="104.5"
        class="h-20 w-auto object-contain"
      />
    </div>
  </div>
</section>
