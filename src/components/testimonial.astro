---
import { Image } from "astro:assets";
import HeroImage from "@/assets/jorgen.jpg";
---

<section id="hero">
  <div
    class="mx-auto flex h-auto w-full max-w-5xl flex-col justify-between gap-2 p-4 md:flex-row"
  >
    <Image
      src={HeroImage}
      alt="joergen andersen"
      class="h-[400px] rounded-lg object-cover object-top md:max-w-md md:object-center"
      loading="eager"
      format="webp"
      fetchpriority="high"
    />
    <div
      class="relative flex flex-col justify-between rounded-lg bg-neutral-100 px-8 py-6"
    >
      <p
        class="indent-[-0.4em] text-3xl leading-tight text-pretty before:text-inherit before:content-[open-quote] after:text-inherit after:content-[close-quote]"
      >
        A forward-looking perspective is essential—those who <em
          >anticipate the future</em
        > are best positioned to shape it, rather than be overtaken by it.
      </p>
      <div class="flex flex-col">
        <span
          class="text-base leading-none font-medium text-nowrap no-underline"
          >Jørgen Andersen</span
        >
        <span class="text-muted-foreground">CEO</span>
      </div>
    </div>
  </div>
</section>
